# Never pack upstream consumer-owned / local project artifacts into the npm tarball.
# Installer seeds fresh empty MEMORY.md + STACK.md for new consumers and preserves existing ones.
# Note: presence of this file means npm does NOT apply root .gitignore — list bytecode/junk here too.

src/skills/ws-shared/config.json
src/skills/ws-shared/config.local.json
src/skills/ws-shared/STACK.md
src/skills/ws-shared/MEMORY.md
src/skills/ws-shared/memory/**
!src/skills/ws-shared/MEMORY.md.template
!src/skills/ws-shared/STACK.md.example
!src/skills/ws-shared/config.json.example

.agents/skills/ws-shared/config.json
.agents/skills/ws-shared/config.local.json
.agents/skills/ws-shared/STACK.md
.agents/skills/ws-shared/MEMORY.md
.agents/skills/ws-shared/CHANGELOG.md
.agents/skills/ws-shared/memory/**
.agents/skills/**/runs/**
.agents/skills/**/.runtime/**
.agents/skills/**/.audit-session-*.json
.agents/skills/**/.finding-step-*.json

**/__pycache__/
**/*.py[cod]
**/*.pyo

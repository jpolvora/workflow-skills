*.py[cod]
*.pyo
ws-check-workflows-report.md

# Workflow disposable scratch (ws-cleanup)
.agents/plans/**/telemetry/
.agents/plans/**/telemetry.jsonl
.agents/plans/**/.runtime/
.agents/plans/**/.finding-*.json
.agents/plans/**/.audit-session-*.json
.agents/plans/**/audit-*.log.md
.agents/plans/**/post-bootstrap-commits.md
.agents/plans/**/*.baseline/
.agents/plans/**/handoff/
.agents/plans/**/step-00-*.issue.json
.agents/plans/**/step-03-*.plan.exec.md
.agents/plans/**/step-03-*.exec.dag.json
.agents/plans/**/runs/
.agents/plans/**/run.json
.agents/plans/**/RUN.md
.agents/plans/**/plan.index.json
.agents/codereviews/PR*.md

# Consumer hub (.ws/): installs get templates/hub.gitignore written as .ws/.gitignore.
# The upstream SoT tracks runtime/ and templates/ under .agents/skills/ws-shared; package.json
# excludes consumer-owned config/state from the npm tarball. Consumer defaults
# track non-secret config.json and maintained STACK.md, while generated state and
# installer metadata are ignored by the installed hub .gitignore.
# Machine-local host probe cache must never ship upstream (spec 0059 AC9).
.ws/host-capabilities.json
.tmp-ws-cleanup-approved.json
.tmp-*/

# Harness benchmark full run reports (upstream maintainer only)
benchmarks/runs/
.active-session-id
.agents/plans/**/pr-body.md

# Workflow observer artifacts (generated by observer.cjs / ws-monitor)
# Ignore the whole folder's contents, but keep human-readable reports.
**/observer/*
!**/observer/*-report.md

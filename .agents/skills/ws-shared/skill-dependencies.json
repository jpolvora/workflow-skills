{
  "version": 1,
  "packageVersion": "0.3.59",
  "upstream": {
    "repo": "jpolvora/workflow-skills",
    "url": "https://github.com/jpolvora/workflow-skills",
    "note": "Managed skills ship from this upstream. Lasting improvements must be submitted as PRs there; consumer copies are overwritten on update."
  },
  "hub": {
    "dir": "ws-shared",
    "ensureWhen": [
      "full",
      "workflows",
      "workflow-skill-selected"
    ]
  },
  "packages": {
    "full": {
      "select": "all-skills",
      "ensureHub": true,
      "shortcut": "f",
      "label": "Full package"
    },
    "workflows": {
      "skills": [
        "ws-spec-to-pr",
        "ws-spec-to-pr-lite",
        "ws-spec-write",
        "ws-classify-complexity",
        "ws-plan-write",
        "ws-plan-interview",
        "ws-plan-to-tasks",
        "ws-implement-tasks",
        "ws-plan-verify",
        "ws-code-review",
        "ws-testing",
        "ws-ship-pr",
        "ws-fix-pr",
        "ws-goal-fix-pr",
        "ws-spec-provider-github",
        "ws-spec-provider-azure-devops",
        "ws-spec-provider-local",
        "ws-check-harness",
        "ws-check-workflows",
        "ws-doctor",
        "ws-tdah",
        "ws-karpathy-guidelines",
        "ws-spec-format",
        "ws-goal-loop",
        "ws-self-learning",
        "ws-changelog",
        "ws-secrets-leak-review",
        "ws-configure-project",
        "ws-fable-method",
        "ws-fable-judge",
        "ws-spec-multi",
        "ws-spec-index",
        "ws-spec-list",
        "ws-spec-from-provider",
        "ws-spec-update",
        "ws-task-lifecycle",
        "ws-senior-developer",
        "ws-pre-daily",
        "ws-spec-explain",
        "ws-cleanup",
        "ws-spec-archive",
        "ws-spec-memo",
        "ws-spec-organizer"
      ],
      "ensureHub": true,
      "shortcut": "w",
      "label": "Workflows package"
    },
    "extra": {
      "skills": [
        "ws-write-a-skill",
        "ws-show-harness",
        "ws-preview",
        "ws-activity-report",
        "ws-fable-domain",
        "ws-plan-update",
        "ws-run-benchmark"
      ],
      "ensureHub": false,
      "shortcut": "e",
      "label": "Extra package"
    }
  },

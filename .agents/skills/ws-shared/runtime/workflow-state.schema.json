{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-state.schema.json",
  "title": "Workflow state",
  "type": "object",
  "required": ["stateVersion", "revision", "workflowId", "slug", "workflowType", "status", "currentStep", "completedSteps", "skippedSteps"],
  "properties": {
    "stateVersion": { "const": 3 },
    "revision": { "type": "integer", "minimum": 0 },
    "workflowId": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "workflowType": { "enum": ["standard", "lite"] },
    "status": { "enum": ["active", "blocked", "completed", "cancelled", "failed"] },
    "shipStatus": {
      "enum": ["pending", "skipped", "pushed", "pr-open", "merged", "stopped"],
      "description": "Shipping lifecycle after implementation close. Terminal: skipped | merged | stopped. Phase A git cleanup runs when shipStatus is terminal, not when status alone is completed."
    },
    "currentStep": { "type": "integer", "minimum": 0, "maximum": 9 },
    "completedSteps": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 9 },
      "uniqueItems": true
    },
    "skippedSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "reason", "evidence"],
        "properties": {
          "step": { "type": "integer", "minimum": 0, "maximum": 9 },
          "reason": {
            "enum": [
              "interview-not-required",
              "dag-disabled",
              "testing-disabled",
              "no-test-surface",
              "fix-pr-not-applicable"
            ]
          },
          "evidence": { "type": "string" }
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "choice", "reason", "round"],
      "properties": {
        "gate": { "type": "string", "minLength": 1 },
        "choice": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "round": { "type": "integer", "minimum": 1 }
      }
    },
    "stepStatus": { "type": "object" },
    "agentTranscripts": {
      "type": "object",
      "description": "us-365: available agent transcript paths recorded by the orchestrator so ws-monitor (and the opt-in watcher) can follow execution. Explicit absent marker when unavailable.",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["available", "transcript-unavailable"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": {
          "enum": ["discovery-disabled", "no-matching-session", "scan-capped"]
        },
        "recordedAt": { "type": "string" }
      },
      "oneOf": [
        {
          "required": ["status", "paths"],
          "properties": {
            "status": { "const": "available" },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "description": "Transcript/session paths correlated to this run."
            },
            "recordedAt": { "type": "string", "format": "date-time" }
          }
        },
        {
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "transcript-unavailable" },
            "reason": {
              "enum": ["discovery-disabled", "no-matching-session", "scan-capped"],
              "description": "Why no transcript is recorded."
            },
            "recordedAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "observer": {
      "type": "object",
      "description": "us-365: opt-in execution-observer dispatch record. At most one watcher dispatch per run.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "dispatchCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "dispatchedAt": { "type": "string", "format": "date-time" },
        "logPath": { "type": "string" },
        "reportPath": { "type": "string" }
      }
    },
    "stepDispatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "dispatchedAt"],
        "properties": {
          "step": { "type": "integer", "minimum": 0, "maximum": 9 },
          "dispatchedAt": { "type": "string", "format": "date-time" },
          "substep": { "type": "string", "minLength": 1 },
          "configuredModel": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "agentType": { "type": "string", "minLength": 1 },
          "subagentId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "workflowManifest": { "type": "object" },
    "telemetry": { "type": "object" },
    "handoffs": { "type": "object", "description": "Unified step handoffs keyed by step number (0.4.0 consolidation, replaces handoff/step-NN.json files)." },
    "baton": {
      "type": "object",
      "description": "Step-level baton record for multi-CLI runs. Absent on legacy states means unclaimed revision 0.",
      "required": ["holder", "step", "claimedAt", "leaseUntil", "revision"],
      "properties": {
        "holder": { "type": ["string", "null"], "description": "Runner id holding the baton, or null when free." },
        "step": { "type": "integer", "minimum": 0, "maximum": 9 },
        "claimedAt": { "type": ["string", "null"], "format": "date-time" },
        "leaseUntil": { "type": ["string", "null"], "format": "date-time" },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "acLedger": { "type": "object", "description": "Folded AC verification ledger (0.4.0 consolidation, replaces standalone ac-ledger.json reads)." },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha", "step"],
        "properties": {
          "sha": { "type": "string", "minLength": 7 },
          "step": { "type": "integer", "minimum": 0, "maximum": 9 },
          "message": { "type": "string" }
        }
      }
    },
    "currentModel": { "type": "string" },
    "configuredModel": { "type": "string" },
    "modelsPreset": { "type": "string" },
    "nextAction": { "type": "string" },
    "pendingGate": { "type": ["object", "null"] },
    "acTotal": { "type": "integer", "minimum": 0 },
    "acImplemented": { "type": "integer", "minimum": 0 },
    "verificationScore": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
    "fableVerdict": { "type": ["string", "null"], "enum": ["VERIFIED", "VERIFIED WITH CAVEATS", null] },
    "statePath": { "type": "string", "pattern": "^(?![A-Za-z]:|/)(?!.*\\\\).+" }
  },
  "additionalProperties": true
}
